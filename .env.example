# ─────────────────────────────────────────────────────────────
# Konfigurasi Gmail Attachment Downloader
# Salin file ini menjadi .env lalu sesuaikan isinya
# ─────────────────────────────────────────────────────────────

# Kata awalan subjek email yang ingin didownload
# Contoh: PWA_T1, DAA_T1, LAPORAN_2024, INVOICE_
SUBJECT_PREFIX=PWA_T2

# Folder output (opsional — default: ./downloads/<SUBJECT_PREFIX>)
# OUTPUT_DIR=C:\Users\NamaAnda\Downloads\attachments

# Maksimal email yang diproses (default: 500)
MAX_RESULTS=500

# Hanya download email yang belum dibaca? (true/false, default: false)
UNREAD_ONLY=false
